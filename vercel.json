{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_FEATHERLESS_API_URL": "@featherless_api_url",
    "VITE_FEATHERLESS_API_KEY": "@featherless_api_key"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
